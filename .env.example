# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN SIC IOT
# Đổi tên file này thành .env và điền giá trị thực tế
# ==========================================

# Cấu hình Wi-Fi cho ESP32 / thiết bị IoT
WIFI_SSID=Your_WiFi_SSID
WIFI_PASSWORD=Your_WiFi_Password

# Cấu hình MQTT Broker
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=sic_iot_client_01
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_TELEMETRY=sic/iot/telemetry
MQTT_TOPIC_COMMAND=sic/iot/command

# Cấu hình Python Service / API Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG=True
